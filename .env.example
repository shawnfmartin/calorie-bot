# Copy to .env and fill in. Never commit .env.
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-BotFather

# Your numeric Telegram user id (the bot tells you it if you message it before setting this).
# Comma-separate several people; each gets their own log, recipes, goal and Health link.
ALLOWED_USER_IDS=

# Your timezone decides when "today" starts and ends, e.g. America/New_York or
# Europe/London. Leave empty to use the Pi's own timezone.
TIMEZONE=

# How calories are estimated:
#   claude-code (default) - the Claude Code CLI on the Pi, using its Claude login
#                           (your Claude Pro/Max subscription; no per-meal cost)
#   api                   - the Anthropic API; also set ANTHROPIC_API_KEY (billed per token)
ESTIMATOR=claude-code

# Optional for claude-code:
# CLAUDE_BIN=/home/pi/.local/bin/claude      # found automatically if left out
# CLAUDE_MODEL=opus                          # defaults to Claude Code's own default model
# CLAUDE_CODE_OAUTH_TOKEN=                   # from `claude setup-token`, if the Pi's login ever expires

# Default meal reminder times (each person can change theirs by asking the bot), or "off":
# REMINDERS=breakfast=10:30,lunch=14:30,dinner=20:30
# Sunday weekly summary chart: a time, or "off":
# WEEKLY_SUMMARY=09:00

# Guardrails against wasted usage:
# CLAUDE_DAILY_LIMIT=100                       # Claude calls per person per day; 0 = no limit
# MAX_MESSAGE_CHARS=3000                       # longer messages are refused without calling Claude
# ESTIMATE_EFFORT=low                          # low | medium | high

# Apple Health sync link for the iPhone Shortcut (say "set up Apple Health" to the bot).
# HEALTH_PORT=8787                              # 0 turns it off
# HEALTH_BASE_URL=http://raspberrypi.local:8787 # what the links point at; found automatically

# Only for ESTIMATOR=api:
# ANTHROPIC_API_KEY=sk-ant-...
